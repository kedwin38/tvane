# Postgres connection string (Railway injects this automatically when
# the app service references ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://user:pass@localhost:5432/tidevane

# --- Bootstrap values for lib/credentials.ts ---
# These seed the encrypted PlatformCredential table on first read. After
# that, /admin/credentials is the source of truth — changing these env
# vars later has no effect until the corresponding DB row is cleared.
DERIV_OAUTH_APP_ID=your_deriv_oauth_app_id
DERIV_APP_ID=1089
DERIV_API_TOKEN=
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# --- Security secrets — generate fresh per environment, never reuse ---
# openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# --- Initial admin bootstrap (scripts/seed-admin.mjs) ---
# Only used once, when no AdminUser row exists yet. Safe to remove from
# the environment after the first successful deploy.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Base URL this deployment is served from (used to build absolute
# redirect targets where needed).
APP_BASE_URL=http://localhost:3000
